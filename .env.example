# Run npm run env:init to generate a private .env with random secrets.
NODE_ENV=development
PORT=3000
POSTGRES_USER=lab_admin
POSTGRES_DB=lab_app
POSTGRES_PASSWORD=replace-with-random-password
APP_DB_PASSWORD=replace-with-another-random-password
DATABASE_URL=postgresql://lab_app_user:replace-with-another-random-password@127.0.0.1:15432/lab_app
MIGRATION_DATABASE_URL=postgresql://lab_admin:replace-with-random-password@127.0.0.1:15432/lab_app
JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_TTL_SECONDS=900
DOCS_ENABLED=true
