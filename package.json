{
  "name": "devsecops-demo-api",
  "version": "0.1.0",
  "private": true,
  "description": "Authenticated task API for the AI-assisted DevSecOps lab",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "env:init": "node scripts/init-env.mjs",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "start:dev": "node --env-file-if-exists=.env --require ts-node/register src/main.ts",
    "migrate": "node --env-file-if-exists=.env dist/database/migrate.js",
    "test": "tsc -p tsconfig.test.json && node --test build-test/test/unit/*.test.js",
    "test:e2e": "tsc -p tsconfig.test.json && node --test --test-concurrency=1 build-test/test/e2e/*.test.js",
    "test:integration": "node scripts/test-integration.mjs",
    "smoke": "node --env-file-if-exists=.env scripts/smoke.mjs"
  },
  "dependencies": {
    "@nestjs/common": "12.1.3",
    "@nestjs/core": "12.1.3",
    "@nestjs/jwt": "12.0.3",
    "@nestjs/platform-express": "12.1.3",
    "@nestjs/swagger": "12.0.2",
    "@nestjs/throttler": "6.7.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "express": "5.3.0",
    "helmet": "8.3.0",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "12.1.3",
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "supertest": "7.3.1",
    "ts-node": "10.9.2",
    "typescript": "5.9.3"
  }
}
